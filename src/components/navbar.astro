---
export const prerender = false;
import {
    Search,
    LoaderCircle,
    Menu,
    Newspaper,
    Upload,
    X,
    Home,
} from "lucide-react";
import Logo from "./logo.astro";
import NavigationState from "./navigation-state.astro";
import { cn } from "@/lib/utils";
import NavbarLink from "./navbar-link.astro";

// TODO: make the navbar dissapear when scrolling down but appear on scroll to the top or when hovering the top of the page
const url = Astro.url;
---

<nav
    class="corner-squircle corner-squircle rounded-md w-full flex items-center justify-between sticky lg:top-12 top-2 z-100 bg-white border-1 border-primary-800 dark:bg-neutral-900 dark:border-neutral-800 lg:px-6 px-2 py-4"
    transition:name="navbar"
>
    <a href="/">
        <Logo className="lg:scale-100 scale-80" />
    </a>
    <input id="navbar-toggle" type="checkbox" class="peer sr-only" />

    <label
        for="navbar-toggle"
        class="block xl:!hidden cursor-pointer peer-checked:hidden"
    >
        <Menu size={48} className="!text-text-50 dark:!text-white" />
    </label>

    <label
        for="navbar-toggle"
        class="hidden xl:!hidden cursor-pointer peer-checked:block"
    >
        <X size={48} className="!text-text-50 dark:!text-white" />
    </label>

    <div
        class={cn(
            "xl:flex hidden xl:flex-row flex-col xl:relative items-center justify-center xl:gap-8 gap-0 !font-extrabold tracking-tight text-2xl",
            "peer-checked:flex peer-checked:absolute peer-checked:w-full peer-checked:top-22 peer-checked:left-0 !z-[1052] peer-checked:bg-neutral-50 dark:peer-checked:bg-neutral-800 peer-checked:rounded-md peer-checked:border-1 peer-checked:border-neutral-300 dark:peer-checked:border-neutral-700 peer-checked:overflow-hidden",
        )}
    >
        <NavbarLink url={"/"}>
            <Home size={32} strokeWidth={3} /> Home
        </NavbarLink>

        <NavbarLink url={"/browse"}>
            <Search size={32} strokeWidth={3} /> Browse
        </NavbarLink>

        <NavbarLink url={"/upload"}>
            <Upload size={32} strokeWidth={3} /> Upload
        </NavbarLink>

        <NavbarLink url={"/blog"}>
            <Newspaper size={32} strokeWidth={3} /> Blog
        </NavbarLink>

        {
            Astro.isPrerendered ? (
                <NavigationState server:defer slot="auth">
                    <a
                        slot="fallback"
                        href="/signin"
                        class:list={[
                            "flex gap-2 xl:p-2 p-4 px-8 items-center cursor-pointer sm:text-xl text-sm hover:text-text-500 focus:text-text-600 transition-colors text-center grayscale-100 pointer-events-none opacity-70",
                            url.pathname === "/signin"
                                ? "!text-text-400 dark:text-text-600 font-bold"
                                : "",
                        ]}
                    >
                        <LoaderCircle size={32} className="animate-spin" />{" "}
                        Loading...
                    </a>
                </NavigationState>
            ) : (
                <NavigationState />
            )
        }
    </div>
</nav>
