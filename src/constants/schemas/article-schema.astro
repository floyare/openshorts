---
import { Schema } from "astro-seo-schema";

interface Props {
    title: string;
    description: string;
    image: string;
    pubDate: Date;
    author: string;
    url: string;
}

const { title, description, image, pubDate, author, url } = Astro.props;

const siteUrl = import.meta.env.SITE || "https://www.openshorts.dev";
---

<Schema
    item={{
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description: description,
        image: [image],
        datePublished: pubDate.toISOString(),
        author: [
            {
                "@type": "Person",
                name: author,
                url: `${siteUrl}/profile/${author}`,
            },
        ],
        publisher: {
            "@type": "Organization",
            name: "openshorts.dev",
            logo: {
                "@type": "ImageObject",
                url: `${siteUrl}/favicon.png`,
            },
        },
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": url,
        },
    }}
/>
